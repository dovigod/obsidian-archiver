# knowledge-hub environment — copy to `.env` and fill in.
# Loaded automatically at runtime by kh / kh-mcp / kh-mcp-http (via dotenv).
# `.env` is gitignored; never commit real secrets.

# --- HTTP MCP server auth (kh-mcp-http) -------------------------------------
# Bearer tokens accepted by the HTTP server. Every token must be >= 16 chars.
# Either source works; they are merged + de-duplicated.

# Single token:
# KH_MCP_TOKEN=replace-with-openssl-rand-hex-32

# Allow-list (comma / whitespace separated):
# KH_MCP_TOKENS=token-one-xxxxxxxxxxxxxxxx,token-two-xxxxxxxxxxxxxxxx

# HTTP server port (default 8000):
# KH_MCP_PORT=8000

# --- Git auto-push (required when git.auto_push is enabled in config) --------
# The repository URL and token are read here, NOT stored in config.
# Server startup throws if auto_push is on and KH_GIT_REMOTE_URL is missing.
# KH_GIT_REMOTE_URL=https://github.com/you/vault.git
# KH_GIT_TOKEN=ghp_...        # https push token; falls back to GITHUB_TOKEN. SSH uses keys.

# --- LLM (Stage 2 distillation) ---------------------------------------------
# Required ONLY when extract.llm.provider = "claude" (API-key mode).
# Subscription mode (provider = "claude-cli") needs nothing here.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: dedup embeddings (dedup.fuzzy.embeddings.provider = "openai")
# OPENAI_API_KEY=sk-...
