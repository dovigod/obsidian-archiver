{
  "name": "knowledge-hub",
  "version": "0.1.0",
  "description": "Personal AI knowledge hub — captures conversations and converts them into reusable structured knowledge in an Obsidian vault.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "kh": "dist/bin/cli.js",
    "kh-mcp": "dist/bin/mcp-server.js",
    "kh-mcp-http": "dist/bin/mcp-http-server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && node scripts/copy-prompts.mjs",
    "dev:mcp": "tsx src/bin/mcp-server.ts",
    "dev:mcp-http": "tsx src/bin/mcp-http-server.ts",
    "dev:cli": "tsx src/bin/cli.ts",
    "dev:worker": "tsx src/bin/cli.ts worker",
    "pretest": "node -e \"require('fs').rmSync('test_result',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "tunnel" : "npx cloudflared tunnel --protocol http2 --url http://localhost:8000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.27.0",
    "tar": "^7.5.15",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
